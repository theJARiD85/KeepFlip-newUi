{
  "expo": {
    "name": "KeepFlip",
    "slug": "keepflip",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon (2).png",
    "scheme": "keepflip",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.keepflip.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow KeepFlip to photograph items for identification and resale analysis."
      }
    },
    "android": {
      "package": "com.keepflip.app",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#030305",
        "foregroundImage": "./assets/images/icon (2).png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon (2).png"
    },
    "plugins": [
      "./plugins/with-appodeal-repository",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow KeepFlip to select item photos for identification and resale analysis.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon (2).png",
          "imageWidth": 225,
          "resizeMode": "contain",
          "backgroundColor": "#030305",
          "dark": {
            "backgroundColor": "#030305"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  },
   "extra": {
       "eas": {
            "projectId": "0315149c-e182-4952-a160-67480953d5f7"
       }
    }
}
