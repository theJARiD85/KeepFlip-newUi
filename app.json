{
  "expo": {
    "name": "KeepFlip",
    "slug": "keepflip",
    "version": "2.1.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "keepflip",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.keepflip.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow KeepFlip to photograph items and receipts for identification and resale records.",
        "NSUserTrackingUsageDescription": "KeepFlip uses your device advertising identifier to measure app installs and ad campaign performance."
      }
    },
    "android": {
      "package": "com.keepflip.app",
      "versionCode": 27,
      "googleServicesFile": "./config/android/google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "com.google.android.gms.permission.AD_ID",
        "com.android.vending.BILLING"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#030305",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "./plugins/with-android-value-radar-memory",
      [
        "./plugins/with-keepflip-android-firebase-signing",
        {
          "keystorePropertiesFile": "./config/android/keystore.properties",
          "keystoreFile": "./config/android/production-keystore.jks"
        }
      ],
      "expo-router",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "KeepFlip uses your device advertising identifier to measure app installs and ad campaign performance."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow KeepFlip to select item and receipt photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon2.png",
          "imageWidth": 225,
          "resizeMode": "contain",
          "light": {
            "backgroundColor": "#030305"
          },
          "dark": {
            "backgroundColor": "#030305"
          }
        }
      ],
      "expo-asset",
      [
        "react-native-fast-tflite",
        {
          "enableAndroidGpuLibraries": true
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "defaultChannel": "keepflip-work"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0315149c-e182-4952-a160-67480953d5f7"
      }
    },
    "owner": "thejarid"
  }
}
