{
  "expo": {
    "name": "KeepFlip",
    "slug": "keepflip",
    "version": "2.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "keepflip",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.keepflip.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow KeepFlip to photograph items for identification and resale analysis."
      }
    },
    "android": {
      "package": "com.keepflip.app",
      "versionCode": 18,
      "googleServicesFile": "./config/android/google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "com.google.android.gms.permission.AD_ID"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#030305",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "./plugins/with-android-value-radar-memory",
      [
        "./plugins/with-keepflip-android-firebase-signing",
        {
          "keystorePropertiesFile": "./config/android/keystore.properties",
          "keystoreFile": "./config/android/production-keystore.jks"
        }
      ],
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow KeepFlip to select item photos for identification and resale analysis.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon2.png",
          "imageWidth": 225,
          "resizeMode": "contain",
          "light": {
            "backgroundColor": "#030305"
          },
          "dark": {
            "backgroundColor": "#030305"
          }
        }
      ],
      "expo-asset",
      [
        "react-native-fast-tflite",
        {
          "enableAndroidGpuLibraries": true
        }
      ],
      "expo-web-browser",
      [
        "@keepflip/expo-appodeal-native-ads",
        {
          "enableAdMob": true,
          "adMobAppId": "ca-app-pub-9259020398529102~7300404509",
          "removeLocationPermissions": true
        }
      ],
      "./plugins/with-appodeal-bidon",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0315149c-e182-4952-a160-67480953d5f7"
      }
    },
    "owner": "thejarid"
  }
}
