{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENABLE_CROSSLISTING_LAB": "true",
        "EXPO_PUBLIC_ENABLE_CROSSLISTING_AUTOFILL": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENABLE_CROSSLISTING_LAB": "true",
        "EXPO_PUBLIC_ENABLE_CROSSLISTING_AUTOFILL": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_ENABLE_CROSSLISTING_LAB": "true",
        "EXPO_PUBLIC_ENABLE_CROSSLISTING_AUTOFILL": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "crosslisting-lab": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_ENABLE_CROSSLISTING_LAB": "true",
        "EXPO_PUBLIC_ENABLE_CROSSLISTING_AUTOFILL": "true",
        "EXPO_PUBLIC_CROSSLISTING_FUNCTION_ID": "crosslisting-api"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "releaseStatus": "draft",
        "track": "internal"
      }
    }
  }
}
