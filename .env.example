# Public Appwrite project identifiers only. Never place provider secrets here.
# Endpoint and project ID enable the pre-scanner authentication boundary.
EXPO_PUBLIC_APPWRITE_ENDPOINT=
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
EXPO_PUBLIC_APPWRITE_PLATFORM=com.keepflip.app

# Scanner analysis resources. Auth can still initialize before these are set.
EXPO_PUBLIC_APPWRITE_SCAN_BUCKET_ID=
EXPO_PUBLIC_APPWRITE_ANALYZE_FUNCTION_ID=
# Preferred multi-market sold-comps function. The legacy eBay ID remains a fallback.
EXPO_PUBLIC_APPWRITE_MARKET_COMPS_FUNCTION_ID=
EXPO_PUBLIC_APPWRITE_EBAY_SOLD_COMPS_FUNCTION_ID=

# Connected eBay account. These are public OAuth client/redirect identifiers,
# never the eBay client secret or stored user tokens.
EXPO_PUBLIC_APPWRITE_EBAY_OAUTH_FUNCTION_ID=
EXPO_PUBLIC_APPWRITE_EBAY_OAUTH_STATES_COLLECTION_ID=ebay_oauth_states
EXPO_PUBLIC_APPWRITE_EBAY_ACCOUNT_DELETION_FUNCTION_ID=
# Optional app-side environment override. Defaults to sandbox in development
# and production in release builds.
EXPO_PUBLIC_EBAY_OAUTH_ENVIRONMENT=
EXPO_PUBLIC_EBAY_CLIENT_ID=
EXPO_PUBLIC_EBAY_RUNAME=
# The app builds the authorize URL from this endpoint at connection time.
EXPO_PUBLIC_EBAY_AUTH_URL=
EXPO_PUBLIC_EBAY_API_URL=
# Current user-token consent should remain least-privileged: base API scope plus
# commerce.identity.readonly. Add more only when the corresponding eBay feature
# is implemented and reviewed.
EXPO_PUBLIC_EBAY_SCOPES=
# Optional authorize-query values. prompt=login is used only when configured.
EXPO_PUBLIC_EBAY_OAUTH_LOCALE=
EXPO_PUBLIC_EBAY_OAUTH_PROMPT=

# Appodeal Android native ads. The app key is a public SDK identifier, not an API secret.
EXPO_PUBLIC_APPODEAL_APP_KEY=
# Defaults to true in development and false in production when omitted.
EXPO_PUBLIC_APPODEAL_TESTING=
EXPO_PUBLIC_TENJIN_API_KEY=

# Optional migrated KeepFlip services and persistent data resources.
EXPO_PUBLIC_APPWRITE_DATABASE_ID=
EXPO_PUBLIC_APPWRITE_NOTIFICATIONS_DATABASE_ID=keepflip_notifications
EXPO_PUBLIC_APPWRITE_NOTIFICATIONS_COLLECTION_ID=notifications
EXPO_PUBLIC_APPWRITE_LEDGER_ENTRIES_TABLE_ID=reseller_ledger_entries
EXPO_PUBLIC_APPWRITE_ITEMS_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_SHELF_TABLE_ID=
EXPO_PUBLIC_APPWRITE_ITEM_PHOTOS_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_MARKETPLACE_LISTINGS_TABLE_ID=
EXPO_PUBLIC_APPWRITE_MARKETPLACE_INQUIRIES_TABLE_ID=
EXPO_PUBLIC_APPWRITE_ASSISTANT_TASKS_TABLE_ID=assistant_tasks
EXPO_PUBLIC_APPWRITE_ASSISTANT_ACTION_RUNS_TABLE_ID=assistant_action_runs
EXPO_PUBLIC_APPWRITE_ASSISTANT_PREFERENCES_TABLE_ID=assistant_preferences
# Configure these only after the owner-scoped assistant_messages table and
# KeepFlip Assistant Function have been created in Appwrite.
EXPO_PUBLIC_APPWRITE_ASSISTANT_MESSAGES_TABLE_ID=
EXPO_PUBLIC_APPWRITE_ASSISTANT_FUNCTION_ID=
EXPO_PUBLIC_APPWRITE_ITEM_IMAGES_BUCKET_ID=
EXPO_PUBLIC_APPWRITE_PROFILE_IMAGES_BUCKET_ID=
EXPO_PUBLIC_APPWRITE_USER_PROFILES_COLLECTION_ID=user_profiles
EXPO_PUBLIC_APPWRITE_ITEM_AI_FUNCTION_ID=
EXPO_PUBLIC_APPWRITE_GOOGLE_LENS_FUNCTION_ID=
EXPO_PUBLIC_APPWRITE_LISTING_GENERATOR_FUNCTION_ID=
EXPO_PUBLIC_APPWRITE_REPAIR_ASSIST_FUNCTION_ID=
EXPO_PUBLIC_APPWRITE_PARTS_RESEARCH_FUNCTION_ID=


# KeepFlip subscriptions / RevenueCat.
# Public SDK keys only. Do not put RevenueCat secret API keys in the mobile app.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# RevenueCat's public Web Billing SDK key. This is not a Stripe publishable
# key, and Stripe secret keys must never be added to EXPO_PUBLIC_ variables.
EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=keepflip_default
# Keep false until store products, entitlements, packages, and free-trial offers are live.
EXPO_PUBLIC_KEEPFLIP_SUBSCRIPTIONS_ENFORCED=false

# Optional store-page overrides for the mandatory minimum-version update gate.
# Android falls back to the KeepFlip Google Play listing. iOS falls back to an
# App Store search until the final KeepFlip App Store listing URL is available.
EXPO_PUBLIC_KEEPFLIP_UPDATE_URL=
EXPO_PUBLIC_KEEPFLIP_IOS_STORE_URL=

EXPO_PUBLIC_APPWRITE_USER_SUBSCRIPTIONS_COLLECTION_ID=user_subscriptions
EXPO_PUBLIC_APPWRITE_SUBSCRIPTION_FUNCTION_ID=keepflip_subscription_police
EXPO_PUBLIC_APPWRITE_BOOKKEEPING_FUNCTION_ID=
