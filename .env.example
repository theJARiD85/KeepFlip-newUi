# Public Appwrite project identifiers only. Never place provider secrets here.
# Endpoint and project ID enable the pre-scanner authentication boundary.
EXPO_PUBLIC_APPWRITE_ENDPOINT=
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
EXPO_PUBLIC_APPWRITE_PLATFORM=com.keepflip.app

# Scanner analysis resources. Auth can still initialize before these are set.
EXPO_PUBLIC_APPWRITE_SCAN_BUCKET_ID=
EXPO_PUBLIC_APPWRITE_ANALYZE_FUNCTION_ID=
# Preferred multi-market sold-comps function. The legacy eBay ID remains a fallback.
EXPO_PUBLIC_APPWRITE_MARKET_COMPS_FUNCTION_ID=
EXPO_PUBLIC_APPWRITE_EBAY_SOLD_COMPS_FUNCTION_ID=

# eBay OAuth app-side configuration. The Function ID is public; eBay credentials and
# token-encryption/state secrets stay exclusively in the Appwrite Function.
EXPO_PUBLIC_APPWRITE_EBAY_OAUTH_FUNCTION_ID=ebay_oauth_callback
# Optional: sandbox or production. Defaults to sandbox in development and production in release builds.
EXPO_PUBLIC_EBAY_OAUTH_ENVIRONMENT=

# Appodeal Android native ads. The app key is a public SDK identifier, not an API secret.
EXPO_PUBLIC_APPODEAL_APP_KEY=
# Defaults to true in development and false in production when omitted.
EXPO_PUBLIC_APPODEAL_TESTING=

# Optional migrated KeepFlip services and persistent data resources.
EXPO_PUBLIC_APPWRITE_DATABASE_ID=
EXPO_PUBLIC_APPWRITE_LEDGER_ENTRIES_TABLE_ID=reseller_ledger_entries
EXPO_PUBLIC_APPWRITE_ITEMS_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_SHELF_TABLE_ID=
EXPO_PUBLIC_APPWRITE_ITEM_PHOTOS_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_MARKETPLACE_LISTINGS_TABLE_ID=
EXPO_PUBLIC_APPWRITE_MARKETPLACE_INQUIRIES_TABLE_ID=
EXPO_PUBLIC_APPWRITE_LEDGER_ENTRIES_TABLE_ID=
EXPO_PUBLIC_APPWRITE_ASSISTANT_TASKS_TABLE_ID=assistant_tasks
EXPO_PUBLIC_APPWRITE_ASSISTANT_ACTION_RUNS_TABLE_ID=assistant_action_runs
EXPO_PUBLIC_APPWRITE_ASSISTANT_PREFERENCES_TABLE_ID=assistant_preferences
EXPO_PUBLIC_APPWRITE_ITEM_IMAGES_BUCKET_ID=
EXPO_PUBLIC_APPWRITE_PROFILE_IMAGES_BUCKET_ID=
EXPO_PUBLIC_APPWRITE_ITEM_AI_FUNCTION_ID=
EXPO_PUBLIC_APPWRITE_GOOGLE_LENS_FUNCTION_ID=
EXPO_PUBLIC_APPWRITE_LISTING_GENERATOR_FUNCTION_ID=
EXPO_PUBLIC_APPWRITE_REPAIR_ASSIST_FUNCTION_ID=
EXPO_PUBLIC_APPWRITE_PARTS_RESEARCH_FUNCTION_ID=
