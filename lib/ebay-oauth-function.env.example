# KeepFlip eBay OAuth Function - server-side variables only
# Never commit or expose CLIENT_SECRET, token encryption keys, refresh tokens,
# OAuth state secrets, or HMAC keys as EXPO_PUBLIC_* variables.

# Sandbox eBay keyset
EBAY_SANDBOX_CLIENT_ID=
EBAY_SANDBOX_CLIENT_SECRET=
EBAY_SANDBOX_RU_NAME=

# Production eBay keyset
EBAY_PRODUCTION_CLIENT_ID=
EBAY_PRODUCTION_CLIENT_SECRET=
EBAY_PRODUCTION_RU_NAME=

# Keep the user-consent grant least-privileged. The current connected-account
# implementation uses Commerce Identity and Seller Analytics, so the grant
# includes only the scopes required by the connected-account, seller setup, and seller-health
# API methods.
EBAY_OAUTH_SCOPES=https://api.ebay.com/oauth/api_scope https://api.ebay.com/oauth/api_scope/commerce.identity.readonly https://api.ebay.com/oauth/api_scope/sell.inventory https://api.ebay.com/oauth/api_scope/sell.account.readonly https://api.ebay.com/oauth/api_scope/sell.analytics.readonly

# Return from the HTTPS Appwrite callback back into the native app.
EBAY_APP_RETURN_URL=keepflip://ebay/connected

# Generate each secret independently and store it only as an Appwrite Function
# environment variable / secret. Never paste generated values into this file.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EBAY_TOKEN_ENCRYPTION_KEY=
EBAY_USER_ID_HMAC_KEY=

# Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
EBAY_OAUTH_STATE_SECRET=

# Appwrite storage identifiers. IDs are configuration; dynamic runtime API keys
# and provider secrets do not belong in this example file.
APPWRITE_EBAY_DATABASE_ID=keepflip
APPWRITE_EBAY_CONNECTIONS_COLLECTION_ID=ebay_connections
APPWRITE_EBAY_OAUTH_STATES_COLLECTION_ID=ebay_oauth_states

# APPWRITE_FUNCTION_API_ENDPOINT and APPWRITE_FUNCTION_PROJECT_ID are supplied
# by the Appwrite runtime. Do not create EXPO_PUBLIC copies for this Function.
